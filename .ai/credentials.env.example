# Copy to .ai/credentials.env and fill in. Never committed.
#
# One set of keys per environment name in .ai/aidlc.yaml `verify.environments`, upper-cased with
# every non-alphanumeric character replaced by an underscore: local-backoffice -> LOCAL_BACKOFFICE_*.
# A blank value counts as missing, which puts verification on the "skipped" rung — never a failure.
#
# The defaults below match `pnpm seed:inventory` (alias: seed:dev-admin).

LOCAL_BACKOFFICE_ORG_ID=
LOCAL_BACKOFFICE_EMAIL=
LOCAL_BACKOFFICE_PASSWORD=

LOCAL_POS_ORG_ID=
LOCAL_POS_EMAIL=
LOCAL_POS_PASSWORD=
# Optional: pin a specific branch instead of the first radio on /chon-chi-nhanh.
# LOCAL_POS_BRANCH_ID=
