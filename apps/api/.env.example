# ── API ──────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── PostgreSQL (host port 5433 to avoid conflict with local 5432) ──
DB_HOST=localhost
DB_PORT=5433
DB_NAME=erp_dev
DB_USER=erp_user
DB_PASS=erp_secret
# Connections per API instance (pg default is 10; server max_connections=100)
DB_POOL_SIZE=20

# ── Redis (host port 6380 to avoid conflict with local 6379) ──
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=erp_redis_secret
REDIS_DB=0

# ── Redpanda / Kafka (host port 19092 to avoid conflict with local 9092) ──
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=erp-api
KAFKA_CONSUMER_GROUP_PREFIX=erp-api

# SASL auth — opt in by setting KAFKA_AUTH_ENABLE=true. When enabled,
# KAFKA_SASL_USERNAME and KAFKA_SASL_PASSWORD are required.
# Mechanism: plain | scram-sha-256 | scram-sha-512 (default scram-sha-256).
# KAFKA_AUTH_ENABLE=false
# KAFKA_SASL_MECHANISM=scram-sha-256
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL=false

# ── JWT ──────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=86400
JWT_REFRESH_TTL=2592000

# ── Reverse proxy (trust proxy) ──────────────
# Number of proxy hops in front of the API in production (nginx/ALB/etc). Used to derive
# req.ip correctly from X-Forwarded-For — required for the API-key IP whitelist to see the
# real caller instead of the proxy. See .ai/features/api-key-auth/03-logical-design.md ADR-03.
TRUST_PROXY_HOPS=1

# ── Monitoring (Prometheus / prom-client) ────
# METRICS_ENABLED=false disables collection and leaves GET /metrics empty (kill switch).
METRICS_ENABLED=true
METRICS_PREFIX=erp_

# ── Media storage (MinIO, S3-compatible) ─────
# MEDIA_S3_ENDPOINT: API → MinIO, internal. MEDIA_PUBLIC_BASE_URL: what the browser
# uses; also the endpoint presigned URLs are signed against. In dev the Vite proxy on
# :3000 forwards /erp-media-public and /erp-media-private to MinIO on :9000.
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_PUBLIC_BASE_URL=http://localhost:3000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ACCESS_KEY=erp_media_access
MEDIA_S3_SECRET_KEY=erp_media_secret
MEDIA_BUCKET_PUBLIC=erp-media-public
MEDIA_BUCKET_PRIVATE=erp-media-private

# Activity log của app mobile — thư mục ghi file JSON lines (mặc định logs/activity)
ACTIVITY_LOG_DIR=
# Số ngày giữ file activity log; 0 = giữ mãi (mặc định 90)
ACTIVITY_LOG_RETENTION_DAYS=

# Thông báo (module notification, `src/modules/notification`)
# Base64 của file JSON service account Firebase Admin (KHÔNG commit file gốc). Trống = tắt push, API vẫn chạy.
#   base64 -i firebase-adminsdk.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_
# false = tắt kênh push dù đã có service account
NOTIFICATION_PUSH_ENABLED=true
# 1 = tắt worker gửi (hàng đợi vẫn nhận dòng mới)
NOTIFICATION_WORKER_DISABLED=0
NOTIFICATION_WORKER_POLL_MS=2000
NOTIFICATION_WORKER_BATCH_SIZE=100
NOTIFICATION_MAX_ATTEMPTS=6
# Push cũ hơn số giây này thì bỏ (không còn giá trị) thay vì gửi
NOTIFICATION_PUSH_TTL_SECONDS=3600
# 1 = tắt các thông báo theo lịch (08:00/09:00) — dùng trên máy dev
NOTIFICATION_SCHEDULE_DISABLED=0
